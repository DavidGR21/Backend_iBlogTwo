# Copia este archivo como .env y completa los valores.
# En Render NO se usa .env: estas mismas variables se cargan en Environment.

NODE_ENV=development
PORT=3000

# Neon → Connect → cadena "pooled" (host con -pooler)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# URL del frontend (Vite en local, Vercel en producción). Admite varias separadas por
# coma (CORS); la primera es la que va en los enlaces de los correos.
FRONTEND_URL=http://localhost:5173

# Genera estos tres valores con: npm run llaves
JWT_SECRETO=
CLAVE_CIFRADO=
CLAVE_HMAC=

# Neon Storage (S3 compatible) → credenciales del bucket
NEON_BUCKET=filesiblog2
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Correo por API HTTP (Render gratis bloquea SMTP). Si queda vacío, los
# correos se imprimen en consola, útil en desarrollo.
BREVO_API_KEY=
CORREO_REMITENTE_NOMBRE=iBlog
CORREO_REMITENTE_EMAIL=
